# tero environment — never commit a filled copy.
# Lean AWS path: one Strands agent + Amazon Bedrock (Nova Lite). No AgentCore.

# 1 = scripted Strands OfflineModel (no AWS). 0 = Amazon Bedrock.
TERO_OFFLINE=1

# Carpeta de trabajo (system of record).
# Default demo: examples/carpeta-demo
# Extra classroom pack: fixtures/aula-5basico-agua
TERO_CARPETA=examples/carpeta-demo

# Bedrock model id (ignored when TERO_OFFLINE=1).
# Canonical: TERO_MODEL. Alias: TERO_MODEL_ID (either works).
TERO_MODEL=amazon.nova-lite-v1:0
# TERO_MODEL_ID=amazon.nova-lite-v1:0
# Cheaper smoke: amazon.nova-micro-v1:0
# Cross-region inference profile (if your account requires it):
# TERO_MODEL=us.amazon.nova-lite-v1:0
# Calidad de material (no son el default; Nova Lite sigue en el README):
# TERO_MODEL=zai.glm-4.7-flash          # barato para iterar
# TERO_MODEL=minimax.minimax-m2.5       # prosa para aceptar con s
# TERO_MODEL=qwen.qwen3-next-80b-a3b    # a menudo escribe tools como texto; salvage + tope

# Region with Nova on-demand (README default).
TERO_AWS_REGION=us-east-1
AWS_REGION=us-east-1

# Skip the typed plan (not recommended).
TERO_SKIP_PLAN=0

# Encargo chips (Spanish classroom context). Prefer catalog OA ids when known.
TERO_CURSO=4° básico
TERO_ASIGNATURA=Lenguaje y Comunicación
TERO_OA=LEN-4B-OA04
TERO_DURACION=45 min
TERO_TIPO=planificacion

# OpenTUI spawns the JSONL bridge with this interpreter.
TERO_PYTHON=python3

# Optional generation knobs (Bedrock path).
# TERO_TEMPERATURE=0.3

# Banco pedagógico "begonia" (material oficial MINEDUC) — solo lectura por HTTP.
# Vacío = banco deshabilitado (default): tero sigue con la carpeta local y lo dice.
TERO_BEGONIA_URL=
# Clave: usa UNA de las dos vías. Nunca commitees el valor.
# TERO_BEGONIA_API_KEY=
# TERO_BEGONIA_KEY_FILE=/ruta/al/archivo-de-claves  # primera línea no vacía; ignora las que parten con #
# TERO_BEGONIA_TIMEOUT=6.0

# Standard AWS resolution (set in the shell, never commit values):
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# AWS_PROFILE=
# AWS_BEARER_TOKEN_BEDROCK=

# Free-tier / new-account checklist (Bedrock):
# 1) Region us-east-1 (or another with Nova on-demand).
# 2) No Model access page (retired). Nova Lite auto-enables on first invoke.
#    Smoke: Bedrock Model catalog / text playground. Cross-region:
#    TERO_MODEL=us.amazon.nova-lite-v1:0
# 3) IAM: bedrock:InvokeModel + bedrock:InvokeModelWithResponseStream.
# 4) cp .env.example .env · set TERO_OFFLINE=0 · fill credentials · never commit .env.
# 5) Video day without keys: python -m tero demo --offline --yes
# 6) Do not iterate in AgentCore Harness on Claude Sonnet / Browser.
#    Playground is a sketch; product loop is this process + carpeta.
#    Playbook: docs/AWS-GRATIS.md
