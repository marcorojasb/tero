# tero environment — no secrets in this file.

# 1 = scripted Strands OfflineModel (no AWS). 0 = Amazon Bedrock.
TERO_OFFLINE=1

# Carpeta de trabajo (system of record). Absolute or relative path.
TERO_CARPETA=examples/carpeta-demo

# Bedrock model id (ignored when TERO_OFFLINE=1).
TERO_MODEL=amazon.nova-lite-v1:0

# Region for Bedrock / boto3.
TERO_AWS_REGION=us-east-1

# Skip the typed plan (not recommended).
TERO_SKIP_PLAN=0

# Encargo chips (Spanish classroom context).
TERO_CURSO=4° básico
TERO_ASIGNATURA=Lenguaje y Comunicación
TERO_OA=OA 4
TERO_DURACION=45 min
TERO_TIPO=planificacion

# Python executable used by the OpenTUI client to spawn the JSONL bridge.
TERO_PYTHON=python3

# Standard AWS resolution (set in the shell, never commit values):
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# AWS_PROFILE=
# AWS_BEARER_TOKEN_BEDROCK=
