# Amazon Bedrock (never commit the filled file)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# Optional: Bedrock API key instead of IAM user keys
# AWS_BEARER_TOKEN_BEDROCK=

# Default model: Amazon Nova Lite (widely available, Spanish-capable,
# no Anthropic first-use form). Change freely.
TERO_MODEL_ID=amazon.nova-lite-v1:0

# Cheaper / smaller:
# TERO_MODEL_ID=amazon.nova-micro-v1:0

# Cross-region inference profile for Nova Lite:
# TERO_MODEL_ID=us.amazon.nova-lite-v1:0

# Optional generation knobs
# TERO_TEMPERATURE=0.3
# TERO_MAX_TOKENS=4096
